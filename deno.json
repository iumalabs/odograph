{
  "fmt": {
    "include": ["src/", "tests/", "*.md", "docs/", "*.json"],
    "exclude": [".specify/", "dist/", ".wrangler/", "node_modules/", "worker-configuration.d.ts"],
    "lineWidth": 100
  },
  "lint": {
    "include": ["src/", "tests/"],
    "exclude": [".specify/", "dist/", ".wrangler/", "node_modules/"],
    "rules": {
      "exclude": ["no-sloppy-imports"]
    }
  },
  "tasks": {
    "dev": "npm run dev",
    "build": "npm run build",
    "typecheck": "npm run typecheck",
    "test": "npm run test",
    "check": "deno fmt --check && deno lint && npm run typecheck && npm run test && bash scripts/check-repository-boundary.sh"
  }
}
